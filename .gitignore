# ==========================================================
# LUKA TRIBUNAL
# Fichier .gitignore principal
# ==========================================================

# ------------------------------
# Dépendances
# ------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# ------------------------------
# Variables d'environnement
# ------------------------------
.env
.env.*
!.env.example

# Secrets
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
secrets/
credentials/

# ------------------------------
# Next.js
# ------------------------------
.next/
out/
dist/
.vercel/
.turbo/

# ------------------------------
# AdonisJS
# ------------------------------
build/
tmp/
coverage/
.adonisjs/
.adonisjs_v6_repl_history

# ------------------------------
# TypeScript
# ------------------------------
*.tsbuildinfo

# ------------------------------
# Logs
# ------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# Tests
# ------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/

# ------------------------------
# Uploads
# ------------------------------
uploads/
storage/uploads/
storage/tmp/
public/uploads/
public/generated/

# ------------------------------
# Base de données
# ------------------------------
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.backup
*.bak

database/backups/
database/dumps/
database/local/

# ------------------------------
# Données géospatiales
# ------------------------------
*.mbtiles
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gdb

tiles/
tile-cache/
map-tiles/

geodata/private/
geodata/raw/
geodata/sensitive/

# ------------------------------
# Données judiciaires sensibles
# ------------------------------
judicial-data/private/
judicial-data/confidential/
judicial-data/children/
judicial-data/victims/

case-files/
complaints/
court-records/

# ------------------------------
# Docker
# ------------------------------
docker-compose.override.yml

docker/volumes/
docker/data/

postgres-data/
redis-data/

# ------------------------------
# IA
# ------------------------------
.codex/
.claude/
.copilot/
.continue/
.cursor/
.jules/

# ------------------------------
# Rapports sécurité
# ------------------------------
security-reports/private/
audit-reports/private/

# ------------------------------
# VS Code
# ------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# ------------------------------
# JetBrains
# ------------------------------
.idea/
*.iml

# ------------------------------
# Linux / Windows / macOS
# ------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.directory
*~

# ------------------------------
# Archives
# ------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# ------------------------------
# Toujours conserver
# ------------------------------
!.env.example
!.gitkeep
